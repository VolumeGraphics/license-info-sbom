{
  "name": "@volumegraphics/license-info-sbom",
  "version": "1.4.0",
  "description": "Builds a CycloneDX SBOM from collected package data and validates it against the CycloneDX JSON schema",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "prepublishOnly": "tsc",
    "build": "tsc",
    "pretest": "node -e \"require('node:fs').rmSync('out-test', { recursive: true, force: true })\"",
    "test": "tsc -p tsconfig.test.json && cd out-test && node --test"
  },
  "author": "Volume Graphics GmbH",
  "homepage": "https://www.volumegraphics.com/",
  "license": "MIT",
  "keywords": [
    "sbom",
    "cyclonedx",
    "license",
    "licensing",
    "dependencies"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolumeGraphics/license-info-sbom.git"
  },
  "dependencies": {
    "@cyclonedx/cyclonedx-library": "^10.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "packageurl-js": "^2.0.1",
    "spdx-expression-parse": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "typescript": "^5.3.3"
  }
}
